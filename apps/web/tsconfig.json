{
  // 别名表只在根 tsconfig.json 维护一份：前端需要跨包解析，dependency-cruiser 也以仓库根为基准
  // 读取同一张表，重复声明会让架构门禁与实际解析漂移。rootDir 显式指向仓库根，抵消继承来的 outDir。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["fenix.module.ts", "src/**/*.ts", "src/**/*.tsx", "components/**/*.ts", "components/**/*.tsx"]
}
