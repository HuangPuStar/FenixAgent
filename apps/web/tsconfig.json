{
  "extends": "../../web/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../web/src/**/*.ts",
    "../../web/src/**/*.tsx",
    "../../web/components/**/*.ts",
    "../../web/components/**/*.tsx"
  ]
}
