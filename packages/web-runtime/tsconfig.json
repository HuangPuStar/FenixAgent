{
  // 包内类型检查入口：**自包含**，不 extends 任何包外 tsconfig（理由同 `packages/ui-components/tsconfig.json`
  // 与 `packages/resources/memory/tsconfig.json` 文件头）。
  // - `web/` 是浏览器面，需要 JSX 与 DOM 类型；`types: ["bun"]` 供包内测试使用 Bun 全局；
  // - `paths` 只映射自身入口与唯一的前置兄弟包 `@fenix/ui-components`（本包在阶段 1 前置落地，
  //   `ui-components` 尚未声明为本包依赖时先用 paths 解析）；其余 `@fenix/*` 走包 exports；
  // - 不写 `baseUrl`：paths 的值在无 baseUrl 时相对本文件解析，且 TS 6.0 起 baseUrl 已弃用。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@fenix/web-runtime/*": ["./web/*"],
      "@fenix/ui-components": ["../ui-components/web/index.ts"],
      "@fenix/ui-components/*": ["../ui-components/web/*"]
    }
  },
  "include": ["web/**/*.ts", "web/**/*.tsx"]
}
