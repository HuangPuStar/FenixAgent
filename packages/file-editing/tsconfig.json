{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": "../.."
  },
  "include": [
    "contracts/**/*.ts",
    "src/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "../*/web/**/*.d.ts",
    "../*/*/web/**/*.d.ts"
  ]
}
