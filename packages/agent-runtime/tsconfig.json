{
  // 本包只声明 `@server/*`：§1.6 T6e 后包内 `src/**` 与 `web/**` 对宿主的能力全部经
  // `@fenix/*` 公开出口或端口注入取得，`@/src/*`、`@/components/*` 的宿主别名已归零
  // （此前那些条目让宿主式说明符在本包内静默解析到 apps/web，属 `web-package-not-to-app`
  // 台账里的存量债务）。刻意不再补回：别名一旦存在，包内多写一行 `@/` 也不会报错。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@server/*": ["apps/server/src/*"]
    }
  },
  "include": ["src/**/*.ts", "web/**/*.ts", "web/**/*.tsx"]
}
