{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@server/*": ["apps/server/src/*"],
      "@/components/chat/*": ["packages/agent-runtime/web/components/chat/*"],
      "@/components/ui/*": ["apps/web/components/ui/*"],
      "@/components/*": ["web/components/*"],
      "@/src/api/environments": ["packages/agent-runtime/web/api/environments.ts"],
      "@/src/hooks/use-chat-state": ["packages/agent-runtime/web/hooks/use-chat-state.ts"],
      "@/src/hooks/use-session-state": ["packages/agent-runtime/web/hooks/use-session-state.ts"],
      "@/src/pages/agent-panel/ChatPanel": ["packages/agent-runtime/web/agent-panel/ChatPanel.tsx"],
      "@/src/pages/agent-panel/chat-auth-state": ["packages/agent-runtime/web/agent-panel/chat-auth-state.ts"],
      "@/src/pages/agent-panel/chat-visible-reconnect": [
        "packages/agent-runtime/web/agent-panel/chat-visible-reconnect.ts"
      ],
      "@/src/pages/agent-panel/session-mutation-refresh": [
        "packages/agent-runtime/web/agent-panel/session-mutation-refresh.ts"
      ],
      "@/src/yjs/*": ["packages/agent-runtime/web/yjs/*"],
      "@/src/i18n/locales/*": ["web/src/i18n/locales/*"],
      "@/src/i18n": ["apps/web/src/i18n/index.ts"],
      "@/src/api/request": ["apps/web/src/api/request.ts"],
      "@/src/api/helpers": ["apps/web/src/api/helpers.ts"],
      "@/src/lib/card-renderer": ["apps/web/src/lib/card-renderer/index.ts"],
      "@/src/lib/card-renderer/*": ["apps/web/src/lib/card-renderer/*"],
      "@/src/lib/auth-client": ["apps/web/src/lib/auth-client.ts"],
      "@/src/lib/utils": ["apps/web/src/lib/utils.ts"],
      "@/src/lib/random-uuid-polyfill": ["apps/web/src/lib/random-uuid-polyfill.ts"],
      "@/src/lib/theme": ["apps/web/src/lib/theme.ts"],
      "@/src/contexts/OrgContext": ["apps/web/src/contexts/OrgContext.tsx"],
      "@/src/*": ["web/src/*"]
    }
  },
  "include": ["src/**/*.ts", "web/**/*.ts", "web/**/*.tsx"]
}
