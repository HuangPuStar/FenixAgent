    "@fenix/core": "workspace:*",
    "@fenix/logger": "workspace:*",
    "@fenix/orchestration": "workspace:*",
    "@fenix/plugin-sdk": "workspace:*",
    "@fenix/remote-runtime": "workspace:*",
    "acp-link": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.10.1",
    "uuid": "^14.0.0",
    "yjs": "^13.6.31"
