{
  "name": "@fenix/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./server/environment": {
      "types": "./src/server/repositories/environment.ts",
      "default": "./src/server/repositories/environment.ts"
    },
    "./server/orchestration-environment": {
      "types": "./src/server/repositories/environment-orchestration.ts",
