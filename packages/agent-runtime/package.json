      "types": "./web/api/environments.ts",
      "default": "./web/api/environments.ts"
    },
    "./web/api/fs": {
      "types": "./web/api/fs.ts",
      "default": "./web/api/fs.ts"
    },
    "./web/api/peri-task-details": {
      "types": "./web/api/peri-task-details.ts",
      "default": "./web/api/peri-task-details.ts"
    },
