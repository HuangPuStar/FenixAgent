{
  // 包内类型检查入口：**自包含**，不 extends 任何包外 tsconfig —— 包的编译设置不得由宿主应用决定
  // （理由与取舍见 `packages/resources/observer/tsconfig.json` 文件头）。本包 `exports` 指向 `src/*.ts`，
  // 消费方直接编译本包源码，因此必须能独立通过类型检查。
  // 门禁：`scripts/typecheck-packages.ts`（`bun run typecheck:packages`，已接入 precheck 与 CI）。
  // - `web/**` 是浏览器面：需要 JSX 与 DOM 类型；`types: ["bun"]` 供服务端代码与包内测试使用 Bun 全局；
  // - 无 `paths`：跨包一律走各包 `exports`，别名表留着反而会掩盖宿主导入回潮；
  // - 不写 `baseUrl`：paths 在无 baseUrl 时相对本文件解析，且 TS 6.0 起 `baseUrl` 已弃用。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": "../../.."
  },
  // 末两条 include 是**各包自带的类型垫片**：本包经 `exports` 引到的对端文件会在本程序内解析自己的
  // import，垫片不在本程序里就会把对端的第三方模块与 `.css` 报成 TS7016 / TS2882。
  "include": [
    "fenix.module.ts",
    "src/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "../../*/web/**/*.d.ts",
    "../../*/*/web/**/*.d.ts"
  ]
}
