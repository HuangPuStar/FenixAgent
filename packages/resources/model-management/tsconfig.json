{
  "extends": "../../../apps/web/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "../../..",
    "baseUrl": "../../..",
    "paths": {
      "@fenix/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@fenix/core": ["packages/core/src/index.ts"],
      "@fenix/opencode": ["packages/plugin-opencode/src/index.ts"],
      "@fenix/orchestration": ["packages/orchestration/src/index.ts"],
      "@fenix/claude-code": ["packages/plugin-claude-code/src/index.ts"],
      "@fenix/ccb": ["packages/plugin-ccb/src/index.ts"],
      "@fenix/workflow-engine": ["packages/workflow-engine/src/index.ts"],
      "@fenix/remote-runtime": ["packages/remote-runtime/src/index.ts"],
      "@fenix/logger": ["packages/logger/src/index.ts"],
      "@fenix/chat-channel": ["packages/chat-channel/src/index.ts"],
      "@fenix/chat-channel/server": ["packages/chat-channel/src/server.ts"],
      "@fenix/model-management": ["packages/resources/model-management/src/index.ts"],
      "@fenix/model-management/server": ["packages/resources/model-management/src/server.ts"],
      "@fenix/web-runtime/*": ["packages/web-runtime/web/*"],
      "@fenix/ui-components": ["packages/ui-components/web/index.ts"],
      "@fenix/ui-components/*": ["packages/ui-components/web/*"],
      "@server/*": ["apps/server/src/*"],
      "@/components/ui/*": ["apps/web/components/ui/*"],
      "@/components/*": ["apps/web/components/*"],
      "@/src/i18n/locales/*": ["apps/web/src/i18n/locales/*"],
      "@/src/i18n": ["apps/web/src/i18n/index.ts"],
      "@/src/api/helpers": ["apps/web/src/api/helpers.ts"],
      "@/src/api/knowledge-models": ["packages/resources/knowledge/web/api/knowledge-models.ts"],
      "@/src/lib/utils": ["apps/web/src/lib/utils.ts"],
      "@/src/api/models": ["packages/resources/model-management/web/api/models.ts"],
      "@/src/api/providers": ["packages/resources/model-management/web/api/providers.ts"],
      "@/src/api/model-gateway": ["packages/resources/model-management/web/api/model-gateway.ts"],
      "@/src/lib/model-config-utils": ["packages/resources/model-management/web/lib/model-config-utils.ts"],
      "@/src/lib/model-gateway-usage": ["packages/resources/model-management/web/lib/model-gateway-usage.ts"],
      "@/src/lib/mcp-resource-access": ["packages/resources/mcp/web/lib/mcp-resource-access.ts"],
      "@/src/types/knowledge": ["packages/resources/knowledge/web/types/knowledge.ts"],
      "@/src/pages/agent-panel/agent-editor/*": [
        "packages/resources/agent-config/web/pages/agent-panel/agent-editor/*"
      ],
      "@/components/model-icon/*": ["packages/resources/model-management/web/components/model-icon/*"],
      "@/src/*": ["apps/web/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "web/**/*.ts", "web/**/*.tsx"]
}
