{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@server/*": ["../../../apps/server/src/*"],
      "@/components/ui/*": ["../../../apps/web/components/ui/*"],
      "@/components/*": ["../../../apps/web/components/*"],
      "@/src/api/hindsight": ["web/api/hindsight.ts"],
      "@/src/api/environments": ["../../../packages/agent-runtime/web/api/environments.ts"],
      "@/src/api/fs": ["../../../apps/web/src/api/fs.ts"],
      "@/src/api/request": ["../../../apps/web/src/api/request.ts"],
      "@/src/api/sites": ["../../agent-config/web/api/sites.ts"],
      "@/src/components/agent-panel/WorkbenchPanel": [
        "../../../apps/web/src/components/agent-panel/WorkbenchPanel.tsx"
      ],
      "@/src/components/file-icon-helper": ["../../../apps/web/src/components/file-icon-helper.tsx"],
      "@/src/i18n": ["../../../apps/web/src/i18n/index.ts"],
      "@/src/lib/card-renderer": ["../../../apps/web/src/lib/card-renderer/index.ts"],
      "@/src/lib/utils": ["../../../apps/web/src/lib/utils.ts"],
      "@/src/*": ["../../../apps/web/src/*"]
    }
  },
  "include": ["src/**/*.ts", "web/**/*.ts", "web/**/*.tsx"]
}
