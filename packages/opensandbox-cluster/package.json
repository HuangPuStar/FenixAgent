{
  "name": "@fenix/opensandbox-cluster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test src/__tests__ web/__tests__",
    "typecheck": "tsc-rs -p tsconfig.json --noEmit --incremental false && tsc-rs -p tsconfig.web.json --noEmit --incremental false",
    "build": "bun build src/index.ts --outfile dist/index.js --target=bun",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.15",
    "@fenix/logger": "workspace:*",
    "@fenix/ui-components": "workspace:*",
    "@noble/ciphers": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "smol-toml": "1.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.7",
    "@types/bun": "^1.3.14",
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "^20.9.0",
    "i18next": "^26.2.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14"
  }
}
