{
  "name": "@fenix/ui-components",
  "version": "0.1.0",
  "description": "通用 React UI 组件包（从 apps/web 抽取并纯化），自带最小 Vite 展示页",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./web/index.ts",
      "default": "./web/index.ts"
    },
    "./styles.css": {
      "default": "./web/styles/theme.css"
    },
    "./ui/*": {
      "types": "./web/ui/*",
      "default": "./web/ui/*"
    },
    "./config/*": {
      "types": "./web/config/*",
      "default": "./web/config/*"
    },
    "./ai-elements/*": {
      "types": "./web/ai-elements/*",
      "default": "./web/ai-elements/*"
    },
    "./components/*": {
      "types": "./web/components/*",
      "default": "./web/components/*"
    },
    "./layout/*": {
      "types": "./web/layout/*",
      "default": "./web/layout/*"
    },
    "./lib/*": {
      "types": "./web/lib/*",
      "default": "./web/lib/*"
    },
    "./i18n/locales/*": {
      "default": "./web/i18n/locales/*"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.190",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9",
    "react-file-icon": "^1.6.0",
    "react-hook-form": "^7.76.0",
    "react-resizable-panels": "^4.11.1",
    "recharts": "^3.10.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "i18next": "^26.2.0",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^17"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "i18next": "^26.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
