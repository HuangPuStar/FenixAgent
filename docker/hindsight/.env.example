# Hindsight 长期记忆服务（memory 依赖）环境模板
#
# 本文件进版本控制，真实值填进同目录 .env（.env 不进版本控制，.gitignore 的 .env 规则匹配任意深度）。
# 用法：
#   独立部署：    cp .env.example .env，填完「必需」段再 docker compose -f docker-compose.yml up -d。
#   随主服务启动：./docker/deploy.sh init 把它落成 docker/hindsight/.env；在 docker/deploy.env 打开
#                FENIX_FEATURE_HINDSIGHT=true。DASHSCOPE_API_KEY 放主服务 env（dev 是仓库根 .env、
#                生产是 docker/main/.env）也可以——脚本把主服务 env 导出为 shell 环境，优先于本目录
#                .env（契约 §8.5），两处都写时以主服务 env 为准。
# 权威文档：docs/operations/docker-topology.md（§6 依赖目录契约、§8 env 规范）；本目录 README.md。

# ── 必需：缺失即启动失败（compose 以 ${VAR:?} 校验） ──
# 阿里云百炼 API Key：LLM / Embedding / Reranker 三处共用同一条凭据。密钥类只给键、不给取值。
DASHSCOPE_API_KEY=

# ── 可调：有默认值，按部署形态修改 ──
# API 的宿主回环端口（只绑 127.0.0.1）：本地源码运行时 HINDSIGHT_MCP_URL 指向它（http://localhost:8888）
HINDSIGHT_API_HOST_PORT=8888
# 控制台的宿主回环端口（只绑 127.0.0.1）：管理员浏览器访问用
HINDSIGHT_CP_HOST_PORT=9999

# ── 默认项：通常不需要修改 ──
# （本目录当前没有此类键：模型名、Embedding 批大小、聚合参数都写在 docker-compose.yml 的 environment 里，
#  改动要连容器内端口一起核对，因此不在此处开开关）
