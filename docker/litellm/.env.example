# LiteLLM 模型网关（model-management 依赖）环境模板
#
# 本文件进版本控制，真实值填进同目录 .env（.env 不进版本控制，.gitignore 的 .env 规则匹配任意深度）。
# 用法：
#   随主服务启动：./docker/deploy.sh init 把它落成 docker/litellm/.env；在 docker/deploy.env 打开
#                FENIX_FEATURE_LITELLM=true。共享键放仓库根 .env 也可以（脚本导出为 shell 环境，
#                优先于本目录 .env，契约 §8.5）。
#   独立部署：    cp .env.example .env，填完下面「必需」段，再按这条起（指定 --env-file 后 compose 不再自动读
#                项目目录的 .env，所以两份都给它；后一份优先，仓库根 .env 因此放最后）：
#                docker compose --env-file docker/litellm/.env --env-file ./.env \
#                  -f docker/litellm/docker-compose.yml up -d
#
# 共享键（LITELLM_DB_PASSWORD / POSTGRES_PASSWORD）按 §8.3「共享键只在根 .env 定义」写在仓库根 .env，
# **不在这里重复**：前者是共享 postgres 里 litellm 角色的口令（建库建角色的初始化服务与 DATABASE_URL 都用它，
# 取值要 URL 安全，用 openssl rand -hex 32 生成），后者是共享实例超级用户 rcs 的口令。库与角色由本目录的
# 一次性服务 litellm-db-init 自动创建，不需要手工执行 SQL；口径见本目录 README 的「共享 PostgreSQL」。
#
# 权威文档：docs/operations/docker-topology.md（§6 依赖目录契约、§8 env 规范）；本目录 README.md。

# ── 必需：缺失即启动失败（compose 以 ${VAR:?} 校验） ──
# 网关管理密钥（LiteLLM master key）；必须与仓库根 .env 的 RCS_MODEL_GATEWAY_ADMIN_KEY 同值，
# 否则平台调网关一律 401。密钥类只给键、不给取值。
LITELLM_MASTER_KEY=
# 库内 Provider 凭据的加密盐；已有数据（库内已存凭据）的部署必须填回此前实际生效的值，换值后旧凭据解不开。
LITELLM_SALT_KEY=

# ── 可调：有默认值，按部署形态修改 ──
# 宿主回环端口（只绑 127.0.0.1）：本地源码运行与管理控制台用；容器之间走 fenix-server 内的 4000。
LITELLM_PORT=4000
# 管理控制台口令；留空即用 compose 内置的占位值（默认 admin，只够本地开发），
# 把端口暴露到回环之外前必须改。密钥类只给键、不给取值。
LITELLM_UI_PASSWORD=

# ── 默认项：通常不需要修改 ──
# （本目录当前没有此类键：模型清单是网关库里的运行时数据，走平台管理页维护，不由部署文件持有）
