# LiteLLM 模型网关（model-management 依赖）环境模板
#
# 本文件进版本控制，真实值填进同目录 .env（.env 不进版本控制，.gitignore 的 .env 规则匹配任意深度）。
# 用法：
#   随主服务启动：./docker/deploy.sh init 把它落成 docker/litellm/.env；在 docker/deploy.env 打开
#                FENIX_FEATURE_LITELLM=true。
#   独立部署：    cp .env.example .env，填完下面「必需」段，再起（compose 的项目目录就是本目录，
#                插值读同目录的 .env，不必指定 --env-file）：
#                docker compose -f docker/litellm/docker-compose.yml up -d
#
# 与主服务共值的键：LITELLM_MASTER_KEY 是网关管理密钥，平台侧用**同一个插值键名**引用
# （docker/main/.env 的 RCS_MODEL_GATEWAY_ADMIN_KEY 与它必须同值；随主服务启动时由脚本导出主服务 env
# 带入环境，契约 §8.5）。其余键都只属于本网关。
#
# 权威文档：docs/operations/docker-topology.md（§6 依赖目录契约、§8 env 规范）；本目录 README.md。

# ── 必需：缺失即启动失败（compose 以 ${VAR:?} 校验） ──
# 网关管理密钥（LiteLLM master key）；必须与主服务 env 的 RCS_MODEL_GATEWAY_ADMIN_KEY 同值，
# 否则平台调网关一律 401。密钥类只给键、不给取值。
LITELLM_MASTER_KEY=
# 库内 Provider 凭据的加密盐；已有数据（库内已存凭据）的部署必须填回此前实际生效的值，换值后旧凭据解不开。
LITELLM_SALT_KEY=
# 本目录自带的 litellm-postgres 实例里 litellm 角色的口令（建库建角色由 postgres 镜像初始化时完成，
# 与 DATABASE_URL 里的口令必须同值，因此取值要 URL 安全）。生成：openssl rand -hex 32。
# 改动只在数据目录为空时写进数据库：已有数据时改库内口令要 `ALTER USER litellm PASSWORD`，或重建数据目录。
LITELLM_DB_PASSWORD=

# ── 可调：有默认值，按部署形态修改 ──
# 宿主回环端口（只绑 127.0.0.1）：本地源码运行与管理控制台用；容器之间走 fenix-server 内的 4000。
LITELLM_PORT=4000
# 管理控制台口令；留空即用 compose 内置的占位值（默认 admin，只够本地开发），
# 把端口暴露到回环之外前必须改。密钥类只给键、不给取值。
LITELLM_UI_PASSWORD=

# ── 默认项：通常不需要修改 ──
# （本目录当前没有此类键：模型清单是网关库里的运行时数据，走平台管理页维护，不由部署文件持有）
