####################################################################################################
# FenixAgent 部署配置模板（生成物）
####################################################################################################
# 用法：`./docker/deploy.sh init` 把它复制成 docker/deploy.env（已存在则不覆盖）；deploy.env 不进版本控制。
# 本文件由 `bun run scripts/generate-env-example.ts` 生成，勿手改（`precheck` 的 env-example 步骤按字节比对）。
#
# 覆盖范围 = docker/deploy.sh 的配置面：依赖开关（按 docker/ 下带 docker-compose.yml 的目录发现，与脚本的
# 目录发现同源）与主服务编排里以 profile 门控的可选服务开关。主服务的应用配置、密钥与编排插值键（如端口）
# 写进主服务 env（生产 docker/main/.env、dev 仓库根 .env），本文件不列。
#
# 键行一律是注释行：不写就等于用脚本与 compose 的缺省行为（未列出的依赖不启动），要改再取消注释。
# 镜像版本不在这里：所有镜像固定版本、写在各自 compose 文件里（主服务 rcs 的 image 行随发布更新，dev 与生产两份编排同步）。
# 权威文档：docs/operations/docker-topology.md（§7 配置、§8 env 规范）。

# ── 依赖开关（docker/deploy.env） ───────────────────────────────────────────────────────────────────

# FENIX_FEATURE_AGENT_SITES｜可选｜默认 false
#   启动依赖 docker/agent-sites/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_AGENT_SITES=false

# FENIX_FEATURE_GIT｜可选｜默认 false
#   启动依赖 docker/git/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_GIT=false

# FENIX_FEATURE_HINDSIGHT｜可选｜默认 false
#   启动依赖 docker/hindsight/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_HINDSIGHT=false

# FENIX_FEATURE_LANGBOT｜可选｜默认 false
#   启动依赖 docker/langbot/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_LANGBOT=false

# FENIX_FEATURE_LITELLM｜可选｜默认 false
#   启动依赖 docker/litellm/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_LITELLM=false

# FENIX_FEATURE_NPM_REGISTRY｜可选｜默认 false
#   启动依赖 docker/npm-registry/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_NPM_REGISTRY=false

# FENIX_FEATURE_OPENSANDBOX_CLUSTER｜可选｜默认 false
#   启动依赖 docker/opensandbox-cluster/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_OPENSANDBOX_CLUSTER=false

# FENIX_FEATURE_OPENSANDBOX_SERVER｜可选｜默认 false
#   启动依赖 docker/opensandbox-server/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_OPENSANDBOX_SERVER=false

# FENIX_FEATURE_OPENSANDBOX_SERVER_TUNNEL｜可选｜默认 false
#   启动依赖 docker/opensandbox-server-tunnel/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_OPENSANDBOX_SERVER_TUNNEL=false

# FENIX_FEATURE_PERI_FUSE｜可选｜默认 false
#   启动依赖 docker/peri-fuse/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_PERI_FUSE=false

# FENIX_FEATURE_RAGFLOW｜可选｜默认 false
#   启动依赖 docker/ragflow/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_RAGFLOW=false

# FENIX_FEATURE_SANDBOX_CCB｜可选｜默认 false
#   启动依赖 docker/sandbox-ccb/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_SANDBOX_CCB=false

# FENIX_FEATURE_SANDBOX_DSH｜可选｜默认 false
#   启动依赖 docker/sandbox-dsh/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_SANDBOX_DSH=false

# FENIX_FEATURE_SANDBOX_OPENCODE｜可选｜默认 false
#   启动依赖 docker/sandbox-opencode/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_SANDBOX_OPENCODE=false

# FENIX_FEATURE_SANDBOX_PERI｜可选｜默认 false
#   启动依赖 docker/sandbox-peri/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_SANDBOX_PERI=false

# FENIX_FEATURE_WORKFLOW｜可选｜默认 false
#   启动依赖 docker/workflow/；该目录的必填键见它的 README 与 .env.example。
# FENIX_FEATURE_WORKFLOW=false

# ── 主服务可选服务（随主服务启动） ───────────────────────────────────────────────────────────────────────────

# FENIX_FEATURE_REDIS｜可选｜默认 false
#   Redis 缓存与 Y.Doc 快照持久化（消费方只有主服务 rcs）；未启用时缓存回退进程内 Map。
# FENIX_FEATURE_REDIS=false
