# docker/workflow/.env —— Workflow V2 独立上游栈的部署配置
# 模板：本文件；由 `./docker/deploy.sh init` 物化成同目录 .env（已存在则不覆盖）。.env 不进版本控制、chmod 600。
#
# 三个使用面，改之前先分清（混在一起是过去"两份 env 必须对齐"的根源）：
#   ① 编排参数：docker compose 读它做变量插值（WORKFLOW_STUDIO_TAG / WEB_LISTEN_ADDR）；
#   ② 应用配置：作为 coze-server 的 env_file 传入，是**叠加层**——镜像内 /app/.env 已提供上游全部默认值，
#      这里只写要改的键。写 `KEY=`（空值）等于把该键覆盖为空，不是"保持默认"，不确定就整行注释掉；
#   ③ 共享键（MYSQL_* / RUSTFS_*）**不写在本文件**：唯一权威是主服务 env（生产 docker/main/.env、dev 仓库根 .env），
#      本编排用 ${...} 插值引用。写在这里只会造成两处漂移。
# 基础设施指向（MYSQL_DSN / MINIO_* / REDIS_ADDR / ES_ADDR / MILVUS_ADDR / MQ_NAME_SERVER 等）由
# docker-compose.yml 的 environment 注入（Compose 里 environment 优先于 env_file），**改本文件不会生效**。

# ── ① 编排参数 ──
# 上游三个镜像（server / web-canvas，初始化资产随 server 镜像交付）必须同 tag，且不得低于
# 「初始化资产随镜像交付」的首个发布——低于它时 assets-init 会明确失败，不会静默起半截。
WORKFLOW_STUDIO_TAG=sha-63fd6f8
# 宿主诊断入口（只绑回环）：平台容器走 http://workflow-upstream:80，不经这里。
# 默认 18081：同机 ragflow 的调试发布占 18080（docker/ragflow/.env 默认 RAGFLOW_WEB_PORT=18080），避让。
WEB_LISTEN_ADDR=127.0.0.1:18081

# ── ② 应用配置（按需修改；未列出的键一律沿用镜像默认）──
# 日志级别：trace / debug / info / notice / warn / error
LOG_LEVEL=debug
# 请求体上限（字节）：文件上传与画布产物都走它，默认 1GiB。
MAX_REQUEST_BODY_SIZE=1073741824

# 注册开关：留空 = 允许注册并走 ALLOW_REGISTRATION_EMAIL 白名单；平台首次引导需要向上游自助注册
# 专用账号（见 docker-compose.yml 头部注释），因此默认不关。
# DISABLE_USER_REGISTRATION=
# ALLOW_REGISTRATION_EMAIL=

# 知识库向量化（knowledge 模块使用；不配则知识库能力不可用）。同一时刻只生效一种 EMBEDDING_TYPE。
# EMBEDDING_TYPE=ark
# ARK_EMBEDDING_BASE_URL=
# ARK_EMBEDDING_MODEL=
# ARK_EMBEDDING_API_KEY=
# ARK_EMBEDDING_DIMS=2048

# 模型：开机时把模型注册进库（画布节点执行依赖它）。按序号递增可注册多个；
# 也可以在平台上游管理端自助添加，效果一致。协议取值：ark / openai / deepseek / ollama / qwen / gemini。
# MODEL_PROTOCOL_0=ark
# MODEL_OPENCOZE_ID_0=100001
# MODEL_NAME_0=
# MODEL_ID_0=
# MODEL_API_KEY_0=
# MODEL_BASE_URL_0=

# 插件授权载荷加密密钥（长度必须是 16 / 24 / 32 字节）：镜像自带的是上游公开默认值，
# 生产环境应换成本部署自己的随机值（三枚各一份，改后既有插件授权需要重新授权）。
# PLUGIN_AES_AUTH_SECRET=
# PLUGIN_AES_STATE_SECRET=
# PLUGIN_AES_OAUTH_TOKEN_SECRET=
