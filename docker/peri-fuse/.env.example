# Peri-Fuse 观测服务（Langfuse 兼容实现）环境模板
#
# 本文件进版本控制，真实值填进同目录 .env（.env 不进版本控制，.gitignore 的 .env 规则匹配任意深度）。
# 用法：
#   独立部署：    cp .env.example .env，按需改「可调」段再 docker compose -f docker-compose.yml up -d。
#   随主服务启动：./docker/deploy.sh init 把它落成 docker/peri-fuse/.env；在 docker/deploy.env 打开
#                FENIX_FEATURE_PERI_FUSE=true。
# 权威文档：docs/operations/docker-topology.md（§6 依赖目录契约、§8 env 规范）；本目录 README.md。
#
# Agent 侧的三键（LANGFUSE_BASE_URL / LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY）不在本文件：
# 它们归主服务 env（生产 docker/main/.env、dev 仓库根 .env），由主服务透传给 agent 进程。

# ── 必需：缺失即启动失败（compose 以 ${VAR:?} 校验） ──
# （本目录当前没有此类键：服务起手即用，项目 API key 在控制台里签发）

# ── 可调：有默认值，按部署形态修改 ──
# 宿主发布地址：默认只绑回环（浏览器看控制台、宿主上的 Agent 上报）。Agent 在别的机器、要经宿主地址
# 直连时改成 0.0.0.0 或那台机器可达的网卡地址；peri-fuse 自身没有鉴权与多租户隔离，别直接暴露公网。
PERIFUSE_BIND_ADDR=127.0.0.1
# 宿主发布端口（容器内固定 23332）：LANGFUSE_BASE_URL 与浏览器控制台都用它
PERIFUSE_HOST_PORT=23332
# 镜像版本（= 镜像 tag）：缺省写在本目录 compose 的 image 行插值里（当前 0.5.0），不取消注释就用那个缺省值。
# 取消注释即在这台机器上钉住版本，此后 compose 改缺省值不影响这里（显式钉死）；跟主线可填提交短哈希 tag。
#PERIFUSE_VERSION=0.5.0

# ── 默认项：通常不需要修改 ──
# API key 哈希盐（密钥）：留空则首次启动自动生成并持久化到 ./data/.salt。首次签发 API key 后再改此值
# 会让已有 key 全部失效（要重新签发），已有部署请保持为空或保持同值。
PERIFUSE_SALT=
