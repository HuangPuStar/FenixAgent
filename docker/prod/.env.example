# ============================================================================
# FenixAgent 主编排环境变量
# ============================================================================
# 启动命令：docker compose -f docker/prod/docker-compose.yml up -d

# ── 必填 ────────────────────────────────────────────────────────────────────

# AI 模型（模板创建 Agent 依赖）
OPENAI_API_KEY=your-api-key-here

# 机器注册共享密钥（RCS 与 sandbox 必须一致）
REGISTRY_SECRET=replace-with-a-long-random-secret

# Agent Sites 站点托管 master key（RCS 与 agent-sites 必须一致）
AGENT_SITES_MASTER_KEY=replace-with-a-long-random-secret

# RCS API Keys（JWT 签名 + acp-link 认证）
# RCS_API_KEYS=replace-with-a-long-random-token

# ── 可选：模型配置 ──────────────────────────────────────────────────────────

# OPENAI_BASE_URL=https://api.deepseek.com/v1/
# OPENAI_MODEL=deepseek-v4-flash

# ── 可选：外部服务 ──────────────────────────────────────────────────────────

# 公网访问地址（不设则默认 http://localhost:3000）
# RCS_BASE_URL=https://your-domain.com

# Hindsight 记忆服务（不设则禁用）
# 部署在本机同一 docker 网络：http://hindsight:8888
# 部署在远程机器：http://<remote-ip>:38881
# HINDSIGHT_MCP_URL=

# RagFlow 知识库（不设则禁用）
# RAGFLOW_API_URL=http://ragflow:80
# RAGFLOW_API_KEY=your-ragflow-key-here

# ── 可选：运行时配置 ────────────────────────────────────────────────────────

# 单条 file-ws 消息最大大小，单位 MB，默认 32。
# 大文件 file-ws 传输使用单条 Base64 JSON 消息，超过此限制会触发断链。
# RCS_FILE_WS_MAX_PAYLOAD_MB=32

# 默认机器 ID（用于 sandbox 连接）
# RCS_DEFAULT_MACHINE_ID=mach_xxx
#
# 默认引擎类型：仅 local 执行生效；远程引擎由机器端 AGENT_TYPE 决定
# RCS_DEFAULT_ENGINE_TYPE=opencode
#
# 禁用 local-default 本地节点：设为 true 后所有实例必须路由到远程 machine
# RCS_DISABLE_LOCAL_EXECUTION=false

# 加密密钥（pgcrypto，不设则使用默认值）
# RCS_SECRET_ENCRYPTION_KEY=replace-with-a-long-random-string

# 前端侧边栏隐藏项，逗号分隔（可选）
# APP_HIDDEN_SIDEBAR_TABS=models,mcp,sites

# Agent 默认系统 Prompt（可选，支持 {{agentName}} {{userPrompt}} 占位符）
# RCS_AGENT_SYSTEM_PROMPT=你当前的 Agent 名称是「{{agentName}}」。\n任何情况下都不要提到底层引擎、运行时或实现名称。

# ── 可选：Agent 并发控制和清理策略 ────────────────────────────────────────

# Agent 并发控制
# RCS_ENVIRONMENT_MAX_SESSIONS 设置新建 Environment 可同时运行的 Instance 数量。
# 已有 Environment 继续使用数据库中持久化的 max_sessions；默认值为 5。
# RCS_ENVIRONMENT_MAX_SESSIONS=5
#
# RCS_USER_AGENT_MAX_CONCURRENCY 限制单个用户可同时启动的活跃 Agent 实例数量。
# 仅统计 supplement.userId 与当前启动者一致的活跃实例，默认值为 10。
# RCS_USER_AGENT_MAX_CONCURRENCY=10
#
# RCS_SCHEDULED_AGENT_MAX_CONCURRENCY 限制整个运行时中定时任务可同时启动的活跃 Agent 实例数量。
# 仅统计 spawnSource 为 scheduled 的活跃实例；未设置表示不限制。
# RCS_SCHEDULED_AGENT_MAX_CONCURRENCY=
#
# RCS_AGENT_MAX_CONCURRENCY 限制整个运行时中活跃 Agent 实例的总并发数量。
# 统计当前所有活跃运行时实例；未设置表示不限制。
# RCS_AGENT_MAX_CONCURRENCY=

# Agent 清理策略
# RCS_ACP_IDLE_SWEEP_INTERVAL_SECONDS 控制服务端多久扫描一次 ACP 实例，并判断是否需要清理。
# 默认值为 300 秒（5 分钟）。
# RCS_ACP_IDLE_SWEEP_INTERVAL_SECONDS=300
#
# RCS_ACP_IDLE_TIMEOUT_SECONDS 控制当前端 relay 连接全部断开后，ACP 实例处于空闲状态多久会被清理。
# 默认值为 300 秒（5 分钟）。
# RCS_ACP_IDLE_TIMEOUT_SECONDS=300
#
# RCS_ACP_ACTIVITY_TIMEOUT_SECONDS 控制 ACP 实例在没有业务活动时的硬超时，即使 relay 连接仍然存在也会被清理。
# 默认值为 1200 秒（20 分钟）。
# RCS_ACP_ACTIVITY_TIMEOUT_SECONDS=1200

# ── 可选：日志配置 ──────────────────────────────────────────────────────────

# LOG_LEVEL=info       # debug / info / warn / error
# LOG_FORMAT=json      # pretty / json（本编排默认 json）
# LOG_DIR=logs         # 滚动日志目录
# LOG_RETENTION_DAYS=30

# ── 可选：沙盒配置 ──────────────────────────────────────────────────────────

# RCS_SANDBOX_ENABLED=true
# RCS_SANDBOX_CLUSTER_URL=  #沙盒集群 API 地址
# RCS_SANDBOX_CLUSTER_API_KEY=  #沙盒集群 API Key
# RCS_DEFAULT_SANDBOX_POOL_ID=default
# RCS_DEFAULT_SANDBOX_IMAGE=    #沙盒业务镜像名称

# RCS_DEFAULT_SANDBOX_RESOURCES_JSON='{
#   "cpu": 2,
#   "memoryMb": 512,
#   "diskGb": 5,
#   "gpuCount": 0,
#   "environment": {
#     "TZ": "Asia/Shanghai",
#     "RCS_URL": "ws://沙盒内网可访问的 RCS 地址",
#     "RCS_SECRET": "RCS连接密钥，即 RCS 的 REGISTRY_SECRET",
#     "IS_PERI": "1",
#     "RCS_CCB_COMMAND": "peri",
#     "RCS_CCB_ARGS": "acp"
#   },
#   "volumes": [
#     {
#       "name": "workspace",
#       "source": "workspace",
#       "target": "/app/workspaces"
#     },
#     {
#       "name": "peri-global",
#       "source": "peri-global",
#       "target": "/root/.peri"
#     }
#   ]
# }'
# RCS_DEFAULT_SANDBOX_EXTRA_JSON='{
#   "opensandbox-cluster": {
#     "entrypoint": [
#       "bun",
#       "/usr/local/bin/acp-runtime.js",
#       "peri",
#       "acp"
#     ]
#   }
# }'

# ── 可选：模型网关配置 ──────────────────────────────────────────────────────────

# RCS_MODEL_GATEWAY_TYPE=litellm
# fenix可访问地址
# RCS_MODEL_GATEWAY_BASE_URL=http://litellm:4000

# 沙盒中可访问地址
# RCS_MODEL_GATEWAY_PUBLIC_BASE_URL=http://沙盒中可访问到的litellm地址:34000
# RCS_MODEL_GATEWAY_ADMIN_KEY=litellm的adminKey
# RCS_MODEL_GATEWAY_CREDENTIAL_ENCRYPTION_KEY=加密密钥用的key，32字节长度的随机字符串

# 前端可访问litellm的adminUrl入口
# RCS_MODEL_GATEWAY_ADMIN_UI_URL=http://外部可访问的地址:34000/litellm/ui/

# 默认配额
# RCS_MODEL_GATEWAY_DEFAULT_USER_BUDGET_USD=50
# RCS_MODEL_GATEWAY_DEFAULT_BUDGET_DURATION=30d
