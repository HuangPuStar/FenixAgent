# Forgejo（公共 Git / 工单依赖）环境模板
#
# 本文件进版本控制，真实值填进同目录 .env（.env 不进版本控制，.gitignore 的 data / .env 规则匹配任意深度）。
# 用法：
#   独立部署：    cp .env.example .env，填 FORGEJO_DB_PASSWORD 再 docker compose -f docker-compose.yml up -d。
#   随主服务启动：./docker/deploy.sh init 把它落成 docker/git/.env；在 docker/deploy.env 打开 FENIX_FEATURE_GIT=true。
#   接入已有 Forgejo：本目录保持关闭（FENIX_FEATURE_GIT=false），主服务不读这里的任何键。
# 权威文档：docs/operations/docker-topology.md（§6 依赖目录契约、§8 env 规范）；本目录 README.md。
#
# 键的消费方：compose 只插值标注「compose」的键；标注「运维命令」的键由 README 的初始化命令读取，
# 不进容器——改它们不影响已运行的实例。

# ── 必需：缺失即启动失败（compose 以 ${VAR:?} 校验） ──
# 共享 postgres 里 forgejo 角色的口令（compose）。必须与建库时设的口令同值：改这里不改库里的角色口令，
# Forgejo 只会连不上并反复重启（同步口令的命令见 README「共享 PostgreSQL」）。密钥类只给键、不给取值。
FORGEJO_DB_PASSWORD=

# ── 可调：有默认值，按部署形态修改 ──
# 宿主回环端口（compose）：本地源码运行与管理界面访问用（http://127.0.0.1:3210）；容器之间固定走 3000。
FORGEJO_HOST_PORT=3210
# 共享实例的坐标（compose）：默认是 fenix-server 上 docker/common/ 的 postgres 服务名。
# 库名与角色名也要与 README 的建库命令一致，否则 Forgejo 连到一个不存在的库。
FORGEJO_DB_HOST=postgres
FORGEJO_DB_PORT=5432
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
# 对外基址（compose）：AOS 侧连接配置的 baseUrl 应与它同源。留空即用 compose 的默认值
# http://127.0.0.1:<FORGEJO_HOST_PORT>/（改端口不必改这里）；容器形态改 http://forgejo:3000/，
# 反向代理部署改成实际入口域名。
FORGEJO_ROOT_URL=

# ── 首次初始化：运维命令读取，compose 不插值 ──
# 首个管理员（README「首次初始化」的 forgejo admin user create 命令用这三个值）。
# 账号建在库里之后，改这里不再生效；口令只留在本文件，别写进命令行历史。
FORGEJO_ADMIN_USERNAME=fenix-admin
FORGEJO_ADMIN_EMAIL=
FORGEJO_ADMIN_PASSWORD=
