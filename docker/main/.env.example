####################################################################################################
# FenixAgent 主服务部署环境变量（生成物）
####################################################################################################
# 用法：`./docker/deploy.sh init` 把它落成同目录的 .env（已存在则不覆盖），或在本目录 `cp .env.example .env`。
# 本文件与 docker/main/docker-compose.yml 同目录（落成后即 `docker/main/.env`）：compose 的项目目录就是这里，
# 变量插值与 `env_file` 都读同目录的 `.env`（目标机上不必指定 `--env-file`，也不依赖仓库根 .env）。
# 本文件由 `bun run scripts/generate-env-example.ts` 生成，勿手改（`precheck` 的 env-example 步骤按字节比对）。
#
# 覆盖面 = 宿主 apps/server/src/env.ts 的自有键 + 全部模块 fenix.module.ts 的 envDefinitions；键与逐键说明的
# 真相来源就是那些声明处。键行一律是注释行：按需取消注释并填写，其余键走代码默认值。元信息含义：必填=未设置
# 即启动失败；默认=未设置时生效的代码默认值；改值需重启=该值在装配期被固化。密钥类键不写任何取值——生产用
# `openssl rand -hex 32` 一类方式自行生成，且不得提交。

# ── 宿主 apps/server/src/env.ts ─────────────────────────────────────────────────────────────────

# APP_BRAND_NAME｜可选｜默认 Fenix
#   前端品牌名。
# APP_BRAND_NAME=Fenix

# APP_LOGO_PATH｜可选｜默认空串
#   前端 logo 路径；空串表示使用内置品牌资源。
# APP_LOGO_PATH=

# DATABASE_URL｜必填｜无默认值｜密钥
#   PostgreSQL 连接串；缺失即启动失败。
#   注：容器部署时由编排的 `environment` 显式给出（`postgres://rcs:…@postgres:5432/rcs`，优先级高于本文件），本键只在绕过容器直跑源码时才需要。
# DATABASE_URL=

# NODE_ENV｜可选｜默认 development
#   运行环境标识。
# NODE_ENV=development

# RCS_API_KEYS｜必填｜无默认值｜密钥
#   skill 下载 token 的 HMAC 签名密钥；逗号分隔多把，首个用于签名。
#   注：生产必须是长随机值（`openssl rand -hex 32`）；缺失或为空即启动失败，且不得提交。
# RCS_API_KEYS=

# RCS_APPLICATION_ROOT｜可选｜未设置即不生效
#   应用根目录的绝对路径；用于定位 bundle 之外的静态资源。
# RCS_APPLICATION_ROOT=

# RCS_ASSEMBLY_PROFILE_PATH｜可选｜未设置即不生效
#   装配 profile 的绝对路径；未设置时用应用根下的 deploy/assembly/ce.json（CE 入口）。
# RCS_ASSEMBLY_PROFILE_PATH=

# RCS_BASE_URL｜可选｜默认空串
#   服务公开基址；日志、spawn 的 acp-link 与 better-auth 的回退基址。
#   注：填部署方可达的对外地址（如 https://agent.example.com）：影响生成的回链与 skill 下载链接。
# RCS_BASE_URL=

# RCS_CORS_ORIGIN｜可选｜默认 *
#   允许的跨域来源；`*` 或逗号分隔列表。
# RCS_CORS_ORIGIN=*

# RCS_DB_CONNECT_TIMEOUT_SECONDS｜可选｜默认 30
#   建立连接的超时（秒）。
# RCS_DB_CONNECT_TIMEOUT_SECONDS=30

# RCS_DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS｜可选｜默认 150
#   事务内空闲超时（秒）。
# RCS_DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=150

# RCS_DB_IDLE_TIMEOUT_SECONDS｜可选｜默认 60
#   连接空闲多久被回收（秒）。
# RCS_DB_IDLE_TIMEOUT_SECONDS=60

# RCS_DB_LOCK_TIMEOUT_SECONDS｜可选｜默认 5
#   锁等待超时（秒）。
# RCS_DB_LOCK_TIMEOUT_SECONDS=5

# RCS_DB_MAX_LIFETIME_SECONDS｜可选｜默认 3600
#   连接最长存活时间（秒）。
# RCS_DB_MAX_LIFETIME_SECONDS=3600

# RCS_DB_POOL_MAX｜可选｜默认 20
#   PostgreSQL 连接池上限。
# RCS_DB_POOL_MAX=20

# RCS_DEFAULT_ENGINE_TYPE｜可选｜未设置即不生效
#   本地执行的默认引擎类型；未设置时按 peri。
# RCS_DEFAULT_ENGINE_TYPE=

# RCS_DEFAULT_MACHINE_ID｜可选｜未设置即不生效
#   默认远端执行节点 ID（mach_ 前缀）；agent config 未绑定 machineId 时使用。
# RCS_DEFAULT_MACHINE_ID=

# RCS_DISABLE_LOCAL_EXECUTION｜可选｜默认 false
#   禁用 local-default 本地节点；true 后所有实例必须路由到远端 machine。
# RCS_DISABLE_LOCAL_EXECUTION=false

# RCS_DISABLE_SCHEDULER｜可选｜默认 false
#   跳过启动时的 schedulerService.start()；不是全局只读模式。
# RCS_DISABLE_SCHEDULER=false

# RCS_DISABLE_SIGNUP｜可选｜默认 false
#   关闭前端自助注册：隐藏注册入口并拒绝新用户注册。
# RCS_DISABLE_SIGNUP=false

# RCS_FILE_WS_IDLE_TIMEOUT_MS｜可选｜默认 90000
#   file-ws 多久没有心跳即判定为僵尸连接（毫秒）。
# RCS_FILE_WS_IDLE_TIMEOUT_MS=90000

# RCS_FILE_WS_MAX_PAYLOAD_MB｜可选｜默认 32
#   file-ws 单帧最大载荷（MB）；须容纳远程上传的 base64 帧。
# RCS_FILE_WS_MAX_PAYLOAD_MB=32

# RCS_FILE_WS_SWEEP_ENABLED｜可选｜默认 false
#   是否启用 file-ws 僵尸巡检；默认关闭，旧机器端未实现 keep_alive 时会被误判，需灰度开启。
# RCS_FILE_WS_SWEEP_ENABLED=false

# RCS_FILE_WS_SWEEP_INTERVAL_MS｜可选｜默认 30000
#   file-ws 僵尸连接巡检间隔（毫秒）。
# RCS_FILE_WS_SWEEP_INTERVAL_MS=30000

# RCS_HOST｜可选｜默认 0.0.0.0
#   HTTP 监听地址。
# RCS_HOST=0.0.0.0

# RCS_PORT｜可选｜默认 3000
#   HTTP 监听端口。
# RCS_PORT=3000

# RCS_REDIS_CLUSTER｜可选｜未设置即不生效
#   Redis Cluster 取值；设置后优先于单实例模式。
# RCS_REDIS_CLUSTER=

# RCS_REDIS_PASSWORD｜可选｜未设置即不生效｜密钥
#   Redis 密码。
# RCS_REDIS_PASSWORD=

# RCS_REDIS_URL｜可选｜未设置即不生效｜密钥
#   Redis 连接串；未设置时缓存回退为进程内 Map。
# RCS_REDIS_URL=

# RCS_SYSTEM_API_KEYS｜可选｜未设置即不生效｜密钥
#   /api/system/* 管理端点（建用户、建组织、签发用户级 API Key）使用的系统级密钥；逗号分隔。
# RCS_SYSTEM_API_KEYS=

# RCS_VERSION｜可选｜默认 0.1.0
#   版本号；由构建或镜像注入。
# RCS_VERSION=0.1.0

# RCS_WS_MAX_PAYLOAD_MB｜可选｜默认 128
#   单条 WebSocket 消息上限（MB）。
# RCS_WS_MAX_PAYLOAD_MB=128

# ── 模块 agent-config ───────────────────────────────────────────────────────────────────────────

# AGENT_SITES_BASE_URL｜可选｜未设置即不生效｜改值需重启
#   Agent Sites 平台基址（宿主 AGENT_SITES_BASE_URL）。
# AGENT_SITES_BASE_URL=

# AGENT_SITES_MASTER_KEY｜可选｜未设置即不生效｜密钥｜改值需重启
#   Agent Sites 的 master key（宿主 AGENT_SITES_MASTER_KEY）。
# AGENT_SITES_MASTER_KEY=

# APP_HIDDEN_SIDEBAR_TABS｜可选｜默认空串｜改值需重启
#   控制台侧边栏需要隐藏的 tab id 原始列表（逗号分隔，允许空串）。
# APP_HIDDEN_SIDEBAR_TABS=

# HINDSIGHT_API_TOKEN｜可选｜未设置即不生效｜密钥｜改值需重启
#   Hindsight REST API token（密钥：不得进入日志、响应或错误文案）。
# HINDSIGHT_API_TOKEN=

# LANGFUSE_BASE_URL｜可选｜未设置即不生效｜改值需重启
#   自托管 Langfuse 的基址。
# LANGFUSE_BASE_URL=

# LANGFUSE_PUBLIC_KEY｜可选｜未设置即不生效｜改值需重启
#   Langfuse 观测的 public key。
# LANGFUSE_PUBLIC_KEY=

# LANGFUSE_SECRET_KEY｜可选｜未设置即不生效｜密钥｜改值需重启
#   Langfuse 观测的 secret key（密钥：不得进入日志、响应或错误文案，仅随受信 relay 通道传输）。
# LANGFUSE_SECRET_KEY=

# OPENAI_API_KEY｜可选｜未设置即不生效｜密钥｜改值需重启
#   Agent 智能生成使用的 OpenAI 兼容 API Key（密钥：不得进入日志、响应或错误文案）。
# OPENAI_API_KEY=

# OPENAI_BASE_URL｜可选｜未设置即不生效｜改值需重启
#   OpenAI 兼容端点的基址（宿主 OPENAI_BASE_URL）。
# OPENAI_BASE_URL=

# OPENAI_MODEL｜可选｜未设置即不生效｜改值需重启
#   Agent 智能生成使用的模型名（宿主 OPENAI_MODEL）。
# OPENAI_MODEL=

# RCS_AGENT_SYSTEM_PROMPT｜可选｜默认值为多行文本｜改值需重启
#   下发到 Agent 运行时的系统提示词模板，默认值取自本包导出的 DEFAULT_AGENT_SYSTEM_PROMPT；min(1) 使空串视为配置错误。
# RCS_AGENT_SYSTEM_PROMPT=

# ── 模块 agent-runtime ──────────────────────────────────────────────────────────────────────────

# RCS_ACP_ACTIVITY_TIMEOUT_SECONDS｜可选｜默认 1200｜改值需重启
#   非交互式实例无 ACP 业务活动的硬超时（秒）；默认 1200。
# RCS_ACP_ACTIVITY_TIMEOUT_SECONDS=1200

# RCS_ACP_IDLE_SWEEP_INTERVAL_SECONDS｜可选｜默认 300｜改值需重启
#   非交互式 ACP 实例的空闲巡检间隔（秒）；默认 300。
# RCS_ACP_IDLE_SWEEP_INTERVAL_SECONDS=300

# RCS_ACP_IDLE_TIMEOUT_SECONDS｜可选｜默认 300｜改值需重启
#   非交互式 ACP 实例的空闲回收阈值（秒）；默认 300。
# RCS_ACP_IDLE_TIMEOUT_SECONDS=300

# RCS_AGENT_MAX_CONCURRENCY｜可选｜未设置即不生效｜改值需重启
#   全部活跃 Agent 实例的并发总量上限；未配置即不限制总量。
# RCS_AGENT_MAX_CONCURRENCY=

# RCS_SCHEDULED_AGENT_MAX_CONCURRENCY｜可选｜未设置即不生效｜改值需重启
#   定时任务触发的活跃 Agent 实例并发上限；未配置即不限制定时来源。
# RCS_SCHEDULED_AGENT_MAX_CONCURRENCY=

# RCS_USER_AGENT_MAX_CONCURRENCY｜可选｜默认 10｜改值需重启
#   单用户活跃 Agent 实例的并发上限；默认 10。
# RCS_USER_AGENT_MAX_CONCURRENCY=10

# RCS_WS_KEEPALIVE_INTERVAL｜可选｜默认 20｜改值需重启
#   `/acp/ws` 服务端 keep_alive 数据帧间隔（秒）；默认 20。
# RCS_WS_KEEPALIVE_INTERVAL=20

# RCS_YJS_SNAPSHOT_IDLE_MS｜可选｜默认 500｜改值需重启
#   Chat Doc 快照的静默期（毫秒）；默认 500。
# RCS_YJS_SNAPSHOT_IDLE_MS=500

# RCS_YJS_SNAPSHOT_INTERVAL_MS｜可选｜默认 2000｜改值需重启
#   Chat Doc 快照的 trailing 节流窗口（毫秒）；默认 2000。
# RCS_YJS_SNAPSHOT_INTERVAL_MS=2000

# RCS_YJS_SNAPSHOT_TTL_SECONDS｜可选｜默认 604800｜改值需重启
#   Chat Doc / Session Doc 快照 key 的滑动 TTL（秒）；默认 604800（7 天），每次成功 CAS 续期，用于自然回收旧投影世代；由装配期投影经 ChatChannelDependencies.snapshotPersist 注入 chat-channel 持久层。
# RCS_YJS_SNAPSHOT_TTL_SECONDS=604800

# REGISTRY_SECRET｜可选｜内置默认值（此处不展示）｜密钥｜改值需重启
#   `/acp/*` 接入方必须携带的共享密钥（query secret）。
# REGISTRY_SECRET=

# WORKSPACE_ROOT｜可选｜未设置即不生效｜改值需重启
#   workspace 根目录；未配置时回落到宿主按运行目录解析的 workspaces（工作区路径公式的根）。
# WORKSPACE_ROOT=

# YJS_MAX_CLIENTS｜可选｜默认 200｜改值需重启
#   chat-channel YJS WebSocket 的最大并发连接数；默认 200。
# YJS_MAX_CLIENTS=200

# ── 模块 channel ────────────────────────────────────────────────────────────────────────────────

# HERMES_PLATFORMS｜可选｜未设置即不生效｜改值需重启
#   Hermes 连接后订阅的平台清单，逗号分隔（逐项 trim 并丢弃空项）。
# HERMES_PLATFORMS=

# HERMES_URL｜可选｜未设置即不生效｜改值需重启
#   Hermes IM 网关的 WebSocket 地址。
# HERMES_URL=

# ── 模块 identity ───────────────────────────────────────────────────────────────────────────────

# BETTER_AUTH_SECRET｜可选｜未设置即不生效｜密钥｜改值需重启
#   better-auth 的签名/加密密钥材料（补缺键：宿主 schema 此前未声明，由 better-auth 直读同名变量）。
# BETTER_AUTH_SECRET=

# BETTER_AUTH_URL｜可选｜未设置即不生效｜改值需重启
#   better-auth 的 baseURL（回调/重定向 URL 基址），构造 better-auth 实例时读取。
# BETTER_AUTH_URL=

# RCS_SYSTEM_ADMIN_PASSWORD_FILE｜可选｜默认 ./data/password.txt｜改值需重启
#   系统管理员首次启动引导所用的密码文件路径，ensureSystemAdmin 在启动期读取并生成口令。
# RCS_SYSTEM_ADMIN_PASSWORD_FILE=./data/password.txt

# RCS_TRUSTED_ORIGINS｜可选｜默认空串｜改值需重启
#   逗号分隔的额外可信来源，与 BETTER_AUTH_URL / RCS_BASE_URL 一起经 buildTrustedOrigins 归一后写入 better-auth 的 trustedOrigins。
# RCS_TRUSTED_ORIGINS=

# ── 模块 knowledge ──────────────────────────────────────────────────────────────────────────────

# GOTENBERG_URL｜可选｜默认 http://127.0.0.1:3200｜改值需重启
#   Gotenberg（Office 转 PDF）服务基址，装配期由宿主投影为模块配置 gotenbergUrl；不可用时调用方回退 LibreOffice CLI。
# GOTENBERG_URL=http://127.0.0.1:3200

# RAGFLOW_API_KEY｜可选｜内置默认值（此处不展示）｜密钥｜改值需重启
#   RAGFlow API key。
# RAGFLOW_API_KEY=

# RAGFLOW_API_URL｜可选｜默认 http://localhost:9380｜改值需重启
#   RAGFlow 检索服务的 API 基址（如 http://localhost:9380）。
# RAGFLOW_API_URL=http://localhost:9380

# RAGFLOW_REQUEST_TIMEOUT_MS｜可选｜默认 30000｜改值需重启
#   RAGFlow 单次 HTTP 请求超时（毫秒，正整数）。
# RAGFLOW_REQUEST_TIMEOUT_MS=30000

# ── 模块 machine ────────────────────────────────────────────────────────────────────────────────

# RCS_FILE_EVENTS_MAX_CLIENTS｜可选｜默认 200｜改值需重启
#   /web/file-events 文件变更事件订阅端点的服务级并发连接上限，与 YJS_MAX_CLIENTS 分池互不挤占。
# RCS_FILE_EVENTS_MAX_CLIENTS=200

# RCS_FILE_WS_IDENTITY_STRICT｜可选｜默认 false｜改值需重启
#   file-ws register 的身份绑定严格模式（§7.1）：未知 machine 的注册帧是否按 close(4404) 拒绝。
# RCS_FILE_WS_IDENTITY_STRICT=false

# ── 模块 memory ─────────────────────────────────────────────────────────────────────────────────

# HINDSIGHT_MCP_URL｜可选｜未设置即不生效｜改值需重启
#   Hindsight 长期记忆 MCP 服务地址；无默认值——未设置（含 docker-compose 透传的空串）即「记忆能力整体未启用」。
# HINDSIGHT_MCP_URL=

# ── 模块 model-management ───────────────────────────────────────────────────────────────────────

# RCS_MODEL_GATEWAY_ADMIN_KEY｜可选｜未设置即不生效｜密钥｜改值需重启
#   网关管理密钥（LiteLLM master key 一类）；未配置时网关运行时整体不启用。
# RCS_MODEL_GATEWAY_ADMIN_KEY=

# RCS_MODEL_GATEWAY_ADMIN_UI_URL｜可选｜默认 http://localhost:4000/ui/｜改值需重启
#   管理员浏览器打开网关控制台的地址，系统管理页据此生成跳转链接；未设置时默认 http://localhost:4000/ui/，非 URL 串启动期即被拒。
# RCS_MODEL_GATEWAY_ADMIN_UI_URL=http://localhost:4000/ui/

# RCS_MODEL_GATEWAY_BASE_URL｜可选｜默认 http://localhost:4000｜改值需重启
#   Fenix 后端访问模型网关的 API 基址；未设置时默认 http://localhost:4000，非 URL 串在启动期即被拒绝。
# RCS_MODEL_GATEWAY_BASE_URL=http://localhost:4000

# RCS_MODEL_GATEWAY_CREDENTIAL_ENCRYPTION_KEY｜可选｜未设置即不生效｜密钥｜改值需重启
#   网关写库凭据（Virtual Key）的本地加密密钥；未配置时网关运行时整体不启用（runtime.ts 以「admin key 与加密密钥都缺失」判定不启用）。
# RCS_MODEL_GATEWAY_CREDENTIAL_ENCRYPTION_KEY=

# RCS_MODEL_GATEWAY_DEFAULT_BUDGET_DURATION｜可选｜未设置即不生效｜改值需重启
#   新用户默认预算周期（如 30d / monthly）；permanent、once 与空串被归一成 undefined，表达「不创建周期性预算」。
# RCS_MODEL_GATEWAY_DEFAULT_BUDGET_DURATION=

# RCS_MODEL_GATEWAY_DEFAULT_USER_BUDGET_USD｜可选｜未设置即不生效｜改值需重启
#   首次激活用户的默认预算（美元，非负数）；未配置时不创建默认预算，因此无默认值。
# RCS_MODEL_GATEWAY_DEFAULT_USER_BUDGET_USD=

# RCS_MODEL_GATEWAY_PUBLIC_BASE_URL｜可选｜未设置即不生效｜改值需重启
#   暴露给沙盒 Agent 的网关地址（后端与 Agent 可能处于不同网络命名空间）；未配置时由宿主 buildConfig 回退到 RCS_MODEL_GATEWAY_BASE_URL——回退属投影层语义，故本声明保持 optional() 且不写 defaultValue。
# RCS_MODEL_GATEWAY_PUBLIC_BASE_URL=

# RCS_MODEL_GATEWAY_TYPE｜可选｜默认 litellm｜改值需重启
#   模型网关类型标识（当前为 litellm），决定选用哪个适配器；未设置时默认 litellm。
# RCS_MODEL_GATEWAY_TYPE=litellm

# ── 模块 plugin-market ──────────────────────────────────────────────────────────────────────────

# PLUGIN_MARKET_REGISTRY_MAX_BYTES｜可选｜默认 4194304｜改值需重启
#   私有源响应的字节上限（默认 4 MiB）。
# PLUGIN_MARKET_REGISTRY_MAX_BYTES=4194304

# PLUGIN_MARKET_REGISTRY_TIMEOUT_MS｜可选｜默认 8000｜改值需重启
#   私有源单次 HTTP 请求超时（毫秒，正整数）。
# PLUGIN_MARKET_REGISTRY_TIMEOUT_MS=8000

# PLUGIN_MARKET_REGISTRY_TOKEN｜可选｜未设置即不生效｜密钥｜改值需重启
#   访问 npm 私有源的 Bearer 凭据（可选）。
# PLUGIN_MARKET_REGISTRY_TOKEN=

# PLUGIN_MARKET_REGISTRY_URL｜可选｜未设置即不生效｜改值需重启
#   npm 私有源的 base URL（必须 http/https，如 http://registry.internal:4873）。
# PLUGIN_MARKET_REGISTRY_URL=

# PLUGIN_MARKET_SOURCE_ID｜可选｜默认 npm｜改值需重启
#   来源标识，写入 plugin_market_package.source_id 并参与聚合根唯一键 (source_id, package_name)。
# PLUGIN_MARKET_SOURCE_ID=npm

# ── 模块 sandbox ────────────────────────────────────────────────────────────────────────────────

# RCS_DEFAULT_SANDBOX_AGENT_TYPE｜可选｜默认 peri｜改值需重启
#   默认沙盒 Agent 类型。
# RCS_DEFAULT_SANDBOX_AGENT_TYPE=peri

# RCS_DEFAULT_SANDBOX_EXTRA_JSON｜可选｜未设置即不生效｜改值需重启
#   默认资源池的 Provider 专属扩展配置 JSON。
# RCS_DEFAULT_SANDBOX_EXTRA_JSON=

# RCS_DEFAULT_SANDBOX_IMAGE｜可选｜未设置即不生效｜改值需重启
#   默认沙盒镜像名称。
# RCS_DEFAULT_SANDBOX_IMAGE=

# RCS_DEFAULT_SANDBOX_POOL_ID｜可选｜未设置即不生效｜改值需重启
#   未显式指定运行节点时使用的默认沙盒资源池 ID。
# RCS_DEFAULT_SANDBOX_POOL_ID=

# RCS_DEFAULT_SANDBOX_RESOURCES_JSON｜可选｜未设置即不生效｜改值需重启
#   默认沙盒资源配置 JSON（环境变量、挂载等）。
# RCS_DEFAULT_SANDBOX_RESOURCES_JSON=

# RCS_SANDBOX_CLUSTER_API_KEY｜可选｜未设置即不生效｜密钥｜改值需重启
#   调用 OpenSandbox Cluster 管理 API 的凭据。
# RCS_SANDBOX_CLUSTER_API_KEY=

# RCS_SANDBOX_CLUSTER_URL｜可选｜未设置即不生效｜改值需重启
#   OpenSandbox Cluster 管理 API 基址。
# RCS_SANDBOX_CLUSTER_URL=

# RCS_SANDBOX_ENABLED｜可选｜默认 false｜改值需重启
#   是否启用沙盒默认策略的全局开关。
# RCS_SANDBOX_ENABLED=false

# RCS_SANDBOX_PROVIDER_CREATE_TIMEOUT_MS｜可选｜默认 120000｜改值需重启
#   Provider 创建沙盒资源的超时（毫秒）。
# RCS_SANDBOX_PROVIDER_CREATE_TIMEOUT_MS=120000

# RCS_SANDBOX_PROVIDER_DESTROY_TIMEOUT_MS｜可选｜默认 60000｜改值需重启
#   Provider 销毁沙盒资源的超时（毫秒）。
# RCS_SANDBOX_PROVIDER_DESTROY_TIMEOUT_MS=60000

# RCS_SANDBOX_PROVIDER_REQUEST_TIMEOUT_MS｜可选｜默认 10000｜改值需重启
#   Provider / Cluster 单次普通请求的超时（毫秒）。
# RCS_SANDBOX_PROVIDER_REQUEST_TIMEOUT_MS=10000

# RCS_SANDBOX_PROVIDER_RESUME_TIMEOUT_MS｜可选｜默认 60000｜改值需重启
#   Provider 恢复已停止沙盒资源的超时（毫秒）。
# RCS_SANDBOX_PROVIDER_RESUME_TIMEOUT_MS=60000

# RCS_SANDBOX_RUNTIME_CONNECT_TIMEOUT_MS｜可选｜默认 10000｜改值需重启
#   沙盒创建/恢复后等待 ACP Runtime 回连的最长时间（毫秒）。
# RCS_SANDBOX_RUNTIME_CONNECT_TIMEOUT_MS=10000

# ── 模块 skill ──────────────────────────────────────────────────────────────────────────────────

# SKILL_DIR｜可选｜默认 ./data/skills｜改值需重启
#   技能源目录与归档文件的根目录，默认 ./data/skills（相对路径由宿主按进程 cwd 归一为绝对路径）。
# SKILL_DIR=./data/skills

# ── 模块 workflow ───────────────────────────────────────────────────────────────────────────────

# ACPX_G_URL｜可选｜默认 http://localhost:8848｜改值需重启
#   acpx-g 内部服务基址，/workflow-ui/* 静态代理的转发目标；宿主部署默认 http://localhost:8848。
# ACPX_G_URL=http://localhost:8848

# RCS_WORKFLOW_HMAC_SECRET｜可选｜未设置即不生效｜密钥｜改值需重启
#   工作流引擎审批令牌（approval token）的 HMAC 签名密钥。
# RCS_WORKFLOW_HMAC_SECRET=

# WORKFLOW_TOOLS_DIR｜可选｜默认 ./tools｜改值需重启
#   自定义节点（CustomNode）工具目录，宿主部署默认 ./tools。
# WORKFLOW_TOOLS_DIR=./tools

# ── 模块 workflow-v2 ────────────────────────────────────────────────────────────────────────────

# WORKFLOW_CANVAS_UPSTREAM_URL｜可选｜默认 http://127.0.0.1:18080｜改值需重启
#   `/workflow-canvas/*` 静态反代的上游基址（上游自带前端的静态资源）；默认 http://127.0.0.1:18080。
# WORKFLOW_CANVAS_UPSTREAM_URL=http://127.0.0.1:18080

# WORKFLOW_V2_BFF_RATE_LIMIT_PER_MINUTE｜可选｜默认 1200｜改值需重启
#   画布透传面（`/workflow-canvas/bff/*`）的令牌桶容量与每分钟补充量，按票据 `sub` 计数；默认 1200（≈20 rps）。
# WORKFLOW_V2_BFF_RATE_LIMIT_PER_MINUTE=1200

# WORKFLOW_V2_IFRAME_CODE_TTL_SECONDS｜可选｜默认 60｜改值需重启
#   iframe 一次性 code 的有效期（秒）；默认 60。
# WORKFLOW_V2_IFRAME_CODE_TTL_SECONDS=60

# WORKFLOW_V2_IFRAME_TICKET_TTL_SECONDS｜可选｜默认 900｜改值需重启
#   画布票据的有效期（秒）；默认 900（15 分钟）。
# WORKFLOW_V2_IFRAME_TICKET_TTL_SECONDS=900

# WORKFLOW_V2_NODE_WHITELIST｜可选｜默认 1,2,3,5,8,11,13,15,18,20,30,31,45,58｜改值需重启
#   节点许可集（逗号分隔的数字节点类型）；默认见设计 §5。
# WORKFLOW_V2_NODE_WHITELIST=1,2,3,5,8,11,13,15,18,20,30,31,45,58

# WORKFLOW_V2_PLATFORM_ACCOUNT_EMAIL｜必填｜无默认值｜改值需重启
#   平台上游账号的登录邮箱（FenixAgent 整体映射上游一个用户，设计 §3.1）：账号不存在时，首次引导（如第一个租户建 App）会用它与 `WORKFLOW_V2_PLATFORM_ACCOUNT_PASSWORD` 向上游自助注册，因此不必先人工建号（注册幂等，邮箱已存在则跳过）。
# WORKFLOW_V2_PLATFORM_ACCOUNT_EMAIL=

# WORKFLOW_V2_PLATFORM_ACCOUNT_PASSWORD｜必填｜无默认值｜密钥｜改值需重启
#   平台上游账号的登录密码（passport 邮箱登录用）；账号不存在时，首次引导会以它作为新账号的密码完成自助注册。
# WORKFLOW_V2_PLATFORM_ACCOUNT_PASSWORD=

# WORKFLOW_V2_RECONCILE_INTERVAL_SECONDS｜可选｜默认 300｜改值需重启
#   对账任务的运行周期（秒）；默认 300，`0` 表示禁用。
# WORKFLOW_V2_RECONCILE_INTERVAL_SECONDS=300

# WORKFLOW_V2_SESSION_RATE_LIMIT_PER_MINUTE｜可选｜默认 60｜改值需重启
#   票据端点（`session/exchange` / `session/refresh` / `session/revoke`）的令牌桶容量与每分钟补充量；默认 60。
# WORKFLOW_V2_SESSION_RATE_LIMIT_PER_MINUTE=60

# WORKFLOW_V2_TICKET_SECRET｜必填｜无默认值｜密钥｜改值需重启
#   画布 iframe 票据（HMAC-SHA256）的签名密钥；无默认值，缺失即启动失败。
# WORKFLOW_V2_TICKET_SECRET=

# WORKFLOW_V2_UPSTREAM_BASE_URL｜可选｜默认 http://127.0.0.1:18080｜改值需重启
#   上游工作流引擎上游服务基址，workflow-v2 调用 `/api/workflow_api/*` 与 passport 登录的目标；默认 http://127.0.0.1:18080，与同机部署的上游服务一致。
# WORKFLOW_V2_UPSTREAM_BASE_URL=http://127.0.0.1:18080

# WORKFLOW_V2_UPSTREAM_TIMEOUT_MS｜可选｜默认 10000｜改值需重启
#   单次上游调用的超时（毫秒）；默认 10000。
# WORKFLOW_V2_UPSTREAM_TIMEOUT_MS=10000

# ── 声明面之外的键（14 个）──────────────────────────────────────────────────────────────────────────────

# LOG_LEVEL｜未被声明｜消费方：packages/logger
#   日志级别（debug / info / warn / error），同时作用于控制台与文件输出。
# LOG_LEVEL=

# LOG_FORMAT｜未被声明｜消费方：packages/logger
#   控制台日志格式（pretty / json）；容器编排通常在 environment 里固定为 json。
# LOG_FORMAT=

# LOG_DIR｜未被声明｜消费方：packages/logger
#   滚动日志目录。
# LOG_DIR=

# LOG_RETENTION_DAYS｜未被声明｜消费方：packages/logger
#   日志保留天数；设为 <= 0 关闭清理。
# LOG_RETENTION_DAYS=

# POSTGRES_PASSWORD｜未被声明｜消费方：docker/common/docker-compose.yml、docker-compose.yml（dev）、docker/main/docker-compose.yml、docker/litellm/docker-compose.yml（litellm-db-init 用它建库与角色）
#   基础服务 PostgreSQL 的口令；编排用它拼容器内连接串，改这里也要改已初始化数据库的口令。
# POSTGRES_PASSWORD=

# LITELLM_DB_PASSWORD｜未被声明｜消费方：docker/litellm/docker-compose.yml（litellm-db-init 建角色、litellm 拼连接串）
#   共享 postgres 里 litellm 角色的口令；由 docker/litellm/ 的一次性初始化服务建角色时写入，与它的 DATABASE_URL 必须同值（改这里后重跑初始化服务会同步到库内，不必手工改库）。
# LITELLM_DB_PASSWORD=

# RUSTFS_ACCESS_KEY｜未被声明｜消费方：docker/common/docker-compose.yml（docker/workflow/ 的 s3-init 用它建桶并播种图标）
#   RustFS 对象存储（S3 兼容）的访问键；未设置时用编排里的本地缺省值。消费方按「共享实例的用户」签约，一把键对应全实例。docker/ragflow/ 不再消费共享实例（改为本栈自带实例、用自己的 RAGFLOW_S3_ACCESS_KEY，见 docker/ragflow/.env.example）。
# RUSTFS_ACCESS_KEY=

# RUSTFS_SECRET_KEY｜未被声明｜消费方：docker/common/docker-compose.yml（docker/workflow/ 的 s3-init 用它建桶并播种图标）
#   RustFS 对象存储的密钥；与访问键同属共享实例的一对凭据——拿到就能读写共享实例上的任何桶，消费方同上。
# RUSTFS_SECRET_KEY=

# MYSQL_ROOT_PASSWORD｜未被声明｜消费方：docker/common/docker-compose.yml（docker/workflow/ 读上游 docker/.env 的同名键、两处必须同值；docker/ragflow/ 的 ragflow-mysql-init 取主服务 env，经部署脚本导出）
#   共享 MySQL 的 root 口令；只在数据目录为空时写入数据库，已有数据时改这里不会改库里的账号（要改口令得同时改库或重建数据目录）。
# MYSQL_ROOT_PASSWORD=

# MYSQL_DATABASE｜未被声明｜消费方：docker/common/docker-compose.yml（docker/workflow/ 的 DSN 与它一致）
#   共享 MySQL 首次初始化时创建的库名；只在数据目录为空时生效，只有 workflow 的库（opencoze）与它同值——ragflow 的库（rag_flow）由 ragflow-mysql-init 自建。
# MYSQL_DATABASE=

# MYSQL_USER｜未被声明｜消费方：docker/common/docker-compose.yml（docker/workflow/ 的 DSN 与它一致）
#   共享 MySQL 首次初始化时创建的应用账号；只在数据目录为空时生效，只有 workflow 用它——ragflow 用自己的一次性服务建的库级账号（ragflow）。
# MYSQL_USER=

# MYSQL_PASSWORD｜未被声明｜消费方：docker/common/docker-compose.yml（docker/workflow/ 的 DSN 与它一致）
#   共享 MySQL 应用账号的口令；消费方 DSN 里的口令必须与它一致（上游 docker/.env 同名键）。ragflow 用自己的一次性服务建的账号口令（RAGFLOW_MYSQL_PASSWORD）。
# MYSQL_PASSWORD=

# RCS_URL｜未被声明｜消费方：packages/acp-runtime-cli（读入后经 ServerConfig 交给 packages/plugin-*/*-handler.ts）
#   Agent 侧回连主服务的 WebSocket 基址；daemon 按它改写 skill 下载链接（宿主生成的地址在容器内不可达）。
# RCS_URL=

# RCS_TENANT_ID｜未被声明｜消费方：packages/acp-runtime-cli
#   远端运行时注册时携带的租户标识。
# RCS_TENANT_ID=
