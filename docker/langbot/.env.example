# docker/langbot/.env.example
#
# 三段式：必需 → 可调 → 默认。复制为同目录 .env 后填写；.env 不进版本控制。
# 键的消费方是本目录 docker-compose.yml；主服务侧的 LANGBOT_BASE_URL / LANGBOT_API_KEY
# 写在 docker/main/.env（生产）或仓库根 .env（本地源码运行），两处密钥必须同值。

# ── 必需 ───────────────────────────────────────────────────────────────────────

# LangBot Service API / 内置 MCP Server 的全局密钥（X-API-Key 或 Authorization: Bearer）。
# 生成：openssl rand -hex 32
LANGBOT_API_KEY=

# 生产必填：LangBot 对外可达的 HTTPS 源。IM 平台回调地址、http_bot 入站地址、邀请链接都由它拼出。
# 本地只在本机访问时可留空，缺省 http://127.0.0.1:5300。
LANGBOT_PUBLIC_BASE_URL=

# ── 可调 ───────────────────────────────────────────────────────────────────────

# 宿主回环端口（只绑 127.0.0.1）；容器内固定 5300。
LANGBOT_HTTP_PORT=5300

# ── 默认 ───────────────────────────────────────────────────────────────────────

# 容器时区（与官方编排一致）。
TZ=Asia/Shanghai
