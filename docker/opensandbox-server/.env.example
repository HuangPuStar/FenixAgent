# OpenSandbox Server 节点环境模板（DinD / direct 模式）
#
# 用法：cp .env.example .env 后按需修改，再 docker compose up -d
# 权威文档：docs/operations/docker-topology.md（§6 依赖目录契约、§8 env 规范）
#
# 本文件只提供 compose 插值的键；节点自身的必填配置（api_key / docker.host_ip）在 sandbox.toml，
# 由 sandbox.toml.example 复制后填写。

# ── 必需：缺失即启动失败 ──
# （本目录当前没有此类键；sandbox.toml 的清单见上述注释）

# ── 可调：有默认值，按部署形态修改 ──
# OpenSandbox Server 对外提供 HTTP API 的宿主机端口；Cluster 注册时的 base_url 使用该端口。
OPENSANDBOX_SERVER_PORT=8090
# DinD 模式下映射给沙盒使用的连续端口范围；必须与 sandbox.toml 的 [docker] port_range_* 一致。
SANDBOX_PORT_MIN=10000
SANDBOX_PORT_MAX=10100

# ── 默认项：通常不需要修改 ──
# （本目录当前没有此类键）
