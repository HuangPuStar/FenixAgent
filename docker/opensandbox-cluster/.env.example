# OpenSandbox Cluster 环境模板
#
# 用法：cp .env.example .env 后填写，再 docker compose up -d
# 权威文档：docs/operations/docker-topology.md（§6 依赖目录契约、§8 env 规范、§13.12 必填项校验）

# ── 必需：缺失或为空即启动失败（compose 以 ${VAR:?} 校验） ──
# Server 访问 frps 的地址（域名或 IP，不含端口）
FRP_PUBLIC_ADDRESS=
# frpc/frps 登录认证，以及 frps 回调 Cluster Plugin 的内部路径令牌；请使用字母、数字、-、_
FRP_TOKEN=
# 调用 Cluster 管理接口和代理接口时使用的 Bearer Token；主服务侧 RCS_SANDBOX_CLUSTER_API_KEY 填同值
CLUSTER_SERVICE_API_KEY=
# 用于加密 SQLite 中 OpenSandbox Server API Key 的密钥，必须恰好 32 字节
SERVER_API_KEY_ENCRYPTION_KEY=

# ── 可调：有默认值，按部署形态修改 ──
# frps 对外提供给各个 Server 的 FRP 登录端口；需要在防火墙或负载均衡器上放行。
# 不填写时使用 7000；修改后必须同步更新现有 frpc 配置文件。
FRP_BIND_PORT=7000
# 本机运维访问 Cluster 管理 API 的端口（只绑回环）。主服务走 fenix-server 网络直连容器 8080，
# 不受该值影响；本机 curl 与 fenix-sandbox-ops.sh 需要跟着改。
OPENSANDBOX_CLUSTER_PORT=8080

# ── 默认项：通常不需要修改 ──
# Cluster 访问 OpenSandbox Server 的 HTTP 超时
PROXY_CONNECT_TIMEOUT_MS=3000
PROXY_RESPONSE_TIMEOUT_MS=120000
