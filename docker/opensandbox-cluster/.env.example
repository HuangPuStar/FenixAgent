# OpenSandbox Cluster 衍生镜像名称；通常保持默认，或改成内部镜像仓库地址。
OPENSANDBOX_CLUSTER_IMAGE=aos/opensandbox-cluster:latest

# Cluster 对外提供 HTTP API 的宿主机端口。
PORT=8080

# 容器内监听地址和 SQLite 数据库路径，通常不需要修改。
HOST=0.0.0.0
DATABASE_PATH=/data/opensandbox-cluster.db

# 调用 Cluster 管理接口和代理接口时使用的 Bearer Token。
CLUSTER_SERVICE_API_KEY=change-me

# 用于加密 SQLite 中 OpenSandbox Server API Key 的 32 字节密钥。
SERVER_API_KEY_ENCRYPTION_KEY=01234567890123456789012345678901

# Cluster 访问 OpenSandbox Server 的 HTTP 超时。
PROXY_CONNECT_TIMEOUT_MS=3000
PROXY_RESPONSE_TIMEOUT_MS=120000
