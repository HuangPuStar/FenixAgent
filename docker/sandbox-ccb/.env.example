# Sandbox CCB（ccb 引擎执行节点）环境模板
#
# 用法：
#   随主服务启动：在 docker/deploy.env 打开 FENIX_FEATURE_SANDBOX_CCB=true 即可，本文件无需填
#                （脚本注入 RCS_URL=ws://rcs:3000，RCS_SECRET 取自主服务的 REGISTRY_SECRET）
#   独立部署：    cp .env.example .env，填完下面三项后 docker compose up -d
# 权威文档：docs/operations/docker-topology.md（§8 env 规范、§11.3 执行节点独立部署）

# ── 必需：缺失即启动失败 ──
# 主服务地址（ws:// 或 wss://，指向 RCS 的 HTTP 端口，默认 3001）；
# 独立部署时填主服务可达地址，同容器网络内可用 ws://rcs:3000
RCS_URL=
# 与主服务侧的 REGISTRY_SECRET 同值（注册用共享密钥）；同机启动时脚本自动派生，独立部署必须手填
RCS_SECRET=
# 控制台预创建（或自动创建）的机器 ID，对应主服务侧的 RCS_DEFAULT_MACHINE_ID
RCS_MACHINE_ID=

# ── 可调：有默认值，按部署形态修改 ──
# 容器时区
TZ=Asia/Shanghai

# ── 默认项：通常不需要修改 ──
# （本目录当前没有此类键）
