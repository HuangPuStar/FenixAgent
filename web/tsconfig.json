{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/components/ui/*": ["../apps/web/components/ui/*"],
      "@/components/chat/*": ["../packages/agent-runtime/web/components/chat/*"],
      "@/components/*": ["./components/*"],
      "@/src/i18n/locales/*": ["./src/i18n/locales/*"],
      "@/src/i18n": ["../apps/web/src/i18n/index.ts"],
      "@/src/api/request": ["../apps/web/src/api/request.ts"],
      "@/src/api/helpers": ["../apps/web/src/api/helpers.ts"],
      "@/src/api/agents": ["../packages/resources/agent-config/web/api/agents.ts"],
      "@/src/api/sites": ["../packages/resources/agent-config/web/api/sites.ts"],
      "@/src/api/skills": ["../packages/resources/skill/web/api/skills.ts"],
      "@/src/api/mcp": ["../packages/resources/mcp/web/api/mcp.ts"],
      "@/src/api/knowledge-bases": ["../packages/resources/knowledge/web/api/knowledge-bases.ts"],
      "@/src/api/hindsight": ["../packages/resources/memory/web/api/hindsight.ts"],
      "@/src/api/models": ["../packages/resources/model-management/web/api/models.ts"],
      "@/src/api/environments": ["../packages/agent-runtime/web/api/environments.ts"],
      "@/src/yjs/*": ["../packages/agent-runtime/web/yjs/*"],
      "@/src/hooks/use-chat-state": ["../packages/agent-runtime/web/hooks/use-chat-state.ts"],
      "@/src/hooks/use-session-state": ["../packages/agent-runtime/web/hooks/use-session-state.ts"],
      "@/src/pages/agent-panel/ChatPanel": ["../packages/agent-runtime/web/agent-panel/ChatPanel.tsx"],
      "@/src/pages/agent-panel/chat-auth-state": ["../packages/agent-runtime/web/agent-panel/chat-auth-state.ts"],
      "@/src/pages/agent-panel/chat-visible-reconnect": [
        "../packages/agent-runtime/web/agent-panel/chat-visible-reconnect.ts"
      ],
      "@/src/pages/agent-panel/session-mutation-refresh": [
        "../packages/agent-runtime/web/agent-panel/session-mutation-refresh.ts"
      ],
      "@/src/lib/card-renderer": ["../apps/web/src/lib/card-renderer/index.ts"],
      "@/src/lib/card-renderer/*": ["../apps/web/src/lib/card-renderer/*"],
      "@/src/lib/mcp-resource-access": ["../packages/resources/mcp/web/lib/mcp-resource-access.ts"],
      "@/src/lib/skill-resource-access": ["../packages/resources/skill/web/lib/skill-resource-access.ts"],
      "@/src/lib/model-config-utils": ["../packages/resources/model-management/web/lib/model-config-utils.ts"],
      "@/src/types/knowledge": ["../packages/resources/knowledge/web/types/knowledge.ts"],
      "@/src/lib/auth-client": ["../apps/web/src/lib/auth-client.ts"],
      "@/src/lib/utils": ["../apps/web/src/lib/utils.ts"],
      "@/src/lib/random-uuid-polyfill": ["../apps/web/src/lib/random-uuid-polyfill.ts"],
      "@/src/lib/theme": ["../apps/web/src/lib/theme.ts"],
      "@/src/contexts/OrgContext": ["../apps/web/src/contexts/OrgContext.tsx"],
      "@/*": ["./*"],
      "@server/*": ["../../src/*"],
      "@fenix/chat-channel": ["../packages/chat-channel/src/index.ts"],
      "@fenix/chat-channel/server": ["../packages/chat-channel/src/server.ts"],
      "@fenix/chat-channel/web": ["../packages/chat-channel/web/index.ts"],
      "@fenix/chat-channel/web/chat-area": ["../packages/chat-channel/web/chat-area.ts"],
      "@fenix/model-management": ["../packages/resources/model-management/src/index.ts"]
    }
  },
  "include": ["src", "components"]
}
