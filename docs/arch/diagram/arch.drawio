                <mxCell id="zhfiOrRzaJxSBVEnV8-l-1" parent="JaICVDV1iAnGguHYox8j-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;服务层&lt;/h1&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;提供系统、账号、资源、智能体、工作流相关功能，对外暴露统一能力。&lt;/div&gt;&lt;div&gt;&lt;div class=&quot;layer-head&quot; style=&quot;box-sizing: border-box; display: flex; justify-content: space-between; gap: 16px; align-items: start; padding-bottom: 14px; margin-bottom: 16px; border-bottom: 1px solid oklch(0.9 0.006 95); color: oklch(0.2 0.018 70); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, sans-serif; font-size: medium;&quot;&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="126.58" width="152.95" y="342.42" as="geometry"/>
                </mxCell>
                <mxCell id="K26Q-Ks9X_aNJpcg3wvp-1" parent="JaICVDV1iAnGguHYox8j-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;应用层&lt;/h1&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;基于服务层，进行资源管理，和业务 Agent / 工作流 应用。&lt;/div&gt;&lt;div&gt;&lt;div class=&quot;layer-head&quot; style=&quot;box-sizing: border-box; display: flex; justify-content: space-between; gap: 16px; align-items: start; padding-bottom: 14px; margin-bottom: 16px; border-bottom: 1px solid oklch(0.9 0.006 95); color: oklch(0.2 0.018 70); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, sans-serif; font-size: medium;&quot;&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="119.53" width="152.95" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="K26Q-Ks9X_aNJpcg3wvp-2" parent="JaICVDV1iAnGguHYox8j-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;控制层&lt;/h1&gt;&lt;div&gt;Agent环境管理、生命周期管理。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;管理路径：&lt;/div&gt;&lt;div&gt;节点-&amp;gt;环境-&amp;gt;引擎-&amp;gt;Agent&lt;/div&gt;&lt;div&gt;&lt;div class=&quot;layer-head&quot; style=&quot;box-sizing: border-box; display: flex; justify-content: space-between; gap: 16px; align-items: start; padding-bottom: 14px; margin-bottom: 16px; border-bottom: 1px solid oklch(0.9 0.006 95); color: oklch(0.2 0.018 70); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, sans-serif; font-size: medium;&quot;&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
