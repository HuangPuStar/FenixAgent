                <mxCell id="K26Q-Ks9X_aNJpcg3wvp-4" parent="JaICVDV1iAnGguHYox8j-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;模型网关&lt;/h1&gt;&lt;div&gt;模型的统一管理，提供限额、计费、统计、容灾等能力。&lt;/div&gt;&lt;div&gt;&lt;div class=&quot;layer-head&quot; style=&quot;box-sizing: border-box; display: flex; justify-content: space-between; gap: 16px; align-items: start; padding-bottom: 14px; margin-bottom: 16px; border-bottom: 1px solid oklch(0.9 0.006 95); color: oklch(0.2 0.018 70); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, sans-serif; font-size: medium;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
