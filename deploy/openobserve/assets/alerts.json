[
  {
    "name": "fenix_http_5xx",
    "stream_type": "metrics",
    "stream_name": "http_server_request_duration_count",
    "is_real_time": false,
    "enabled": false,
    "query_condition": {
      "type": "promql",
      "promql": "(sum(increase(http_server_request_duration_count{service_name=\"fenix-server\",http_response_status_code=~\"5..\"}[5m])) / sum(increase(http_server_request_duration_count{service_name=\"fenix-server\"}[5m])) > 0.05) and (sum(increase(http_server_request_duration_count{service_name=\"fenix-server\"}[5m])) >= 100)",
      "promql_condition": { "column": "value", "operator": ">", "value": 0 }
    },
    "trigger_condition": {
      "period": 5,
      "operator": ">=",
      "threshold": 1,
      "frequency": 1,
      "silence": 10,
      "frequency_type": "minutes"
    },
    "destinations": [],
    "description": "5分钟5xx超过5%，最少100请求；先绑定环境及通知目标再启用"
  },
  {
    "name": "fenix_http_p95",
    "stream_type": "metrics",
    "stream_name": "http_server_request_duration_bucket",
    "is_real_time": false,
    "enabled": false,
    "query_condition": {
      "type": "promql",
      "promql": "histogram_quantile(0.95,sum by(le,http_route)(rate(http_server_request_duration_bucket{service_name=\"fenix-server\"}[5m]))) > 2",
      "promql_condition": { "column": "value", "operator": ">", "value": 2 }
    },
    "trigger_condition": {
      "period": 5,
      "operator": ">=",
      "threshold": 1,
      "frequency": 1,
      "silence": 10,
      "frequency_type": "minutes"
    },
    "destinations": [],
    "description": "关键路由P95大于2秒；按实际SLO调整"
  },
  {
    "name": "fenix_pg_pending",
    "stream_type": "metrics",
    "stream_name": "db_client_connection_pending_requests",
    "is_real_time": false,
    "enabled": false,
    "query_condition": {
      "type": "promql",
      "promql": "min_over_time(db_client_connection_pending_requests{service_name=\"fenix-server\"}[5m]) > 0",
      "promql_condition": { "column": "value", "operator": ">", "value": 0 }
    },
    "trigger_condition": {
      "period": 5,
      "operator": ">=",
      "threshold": 1,
      "frequency": 1,
      "silence": 10,
      "frequency_type": "minutes"
    },
    "destinations": [],
    "description": "持续5分钟等待连接，结合连接利用率定位"
  },
  {
    "name": "fenix_sync_backlog",
    "stream_type": "metrics",
    "stream_name": "fenix_sync_outstanding_bytes",
    "is_real_time": false,
    "enabled": false,
    "query_condition": {
      "type": "promql",
      "promql": "deriv(fenix_sync_outstanding_bytes{service_name=\"fenix-server\"}[5m]) > 0",
      "promql_condition": { "column": "value", "operator": ">", "value": 0 }
    },
    "trigger_condition": {
      "period": 5,
      "operator": ">=",
      "threshold": 1,
      "frequency": 1,
      "silence": 10,
      "frequency_type": "minutes"
    },
    "destinations": [],
    "description": "同步积压持续增长，结合现有传输预算与ACK排查"
  },
  {
    "name": "fenix_restore_failure",
    "stream_type": "metrics",
