  {
    "name": "fenix_disk_low",
    "stream_type": "metrics",
    "stream_name": "system_filesystem_usage",
    "is_real_time": false,
    "enabled": false,
    "query_condition": {
      "type": "promql",
      "promql": "system_filesystem_usage{service_name=\"fenix-host\",state=\"free\"}/ignoring(state) sum without(state)(system_filesystem_usage{service_name=\"fenix-host\"}) < 0.15",
