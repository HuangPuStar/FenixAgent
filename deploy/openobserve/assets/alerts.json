    },
    "trigger_condition": {
      "period": 5,
      "operator": ">=",
      "threshold": 1,
      "frequency": 1,
      "silence": 10,
      "frequency_type": "minutes"
    },
    "destinations": [],
    "description": "磁盘剩余低于15%，低于5%升级处理"
  },
  {
    "name": "fenix_telemetry_missing",
