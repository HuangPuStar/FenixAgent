# 必需：上线前填写；凭据不进入 Git，Collector 使用独立采集凭据。
OO_AUTH_HEADER=
HOST_ID=
HOST_NAME=
OTELCOL_INSTANCE_ID=

# 可调：跨机必须使用受控 HTTPS 地址；不带尾部斜线。
OO_OTLP_ENDPOINT=http://openobserve:5080/api/default
DEPLOYMENT_ENVIRONMENT=production

# 默认：附加 receiver 不自动启用；启用时填写并加载对应配置。
PG_MONITOR_ENDPOINT=
PG_MONITOR_USERNAME=
PG_MONITOR_PASSWORD=
PG_MONITOR_DATABASE=
REDIS_MONITOR_ENDPOINT=
REDIS_MONITOR_USERNAME=
REDIS_MONITOR_PASSWORD=
DOCKER_MONITOR_ENDPOINT=
