root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc}]
indent_style = space
indent_size = 2
max_line_length = 120

# Markdown trailing whitespace is significant (two spaces = hard line break).
[*.md]
trim_trailing_whitespace = false
