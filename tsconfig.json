{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "outDir": "dist",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/src/*": ["./apps/web/src/*"],
      "@/src/api/helpers": ["./apps/web/src/api/helpers.ts"],
      "@/src/i18n": ["./apps/web/src/i18n/index.ts"],
      "@/src/i18n/locales/*": ["./apps/web/src/i18n/locales/*"],
      "@/src/lib/random-uuid-polyfill": ["./apps/web/src/lib/random-uuid-polyfill.ts"],
      "@/src/lib/theme": ["./apps/web/src/lib/theme.ts"],
      "@/src/lib/utils": ["./apps/web/src/lib/utils.ts"],
      // 只保留宿主自有别名。指向 `packages/**` 的一批桥接别名（`@/src/api/*`、`@/src/pages/**`、
      // `@/src/lib/*`、`@/src/components/**`、`@/src/types/*`）已随 §1.6 T11e 全部删除：消费方改直连
      // 各包公开出口后它们零消费，留着只会让「包内实现」在宿主侧有一个永不过期的写法。同批删除了
      // `apps/web/vite.config.ts` 里的对应条目——两张表必须一致，dependency-cruiser 也读这张表。
      // 宿主自有别名必须列在这里（`@/src/*` 通配只覆盖宿主 `src/`）。
      // 两表的键写法无法机械对账——vite 表用前缀键（`@/src/i18n/locales`），本表用带 `*` 的路径键
      // （`@/src/i18n/locales/*`）——所以每增删一条都必须同批改 `apps/web/vite.config.ts` 的
      // `resolve.alias`，否则会出现「门禁能解析、生产构建解析不到」。
      "@server/*": ["./apps/server/src/*"]
    }
  },
  // `db/` 只放部署期数据迁移入口（release 步骤，不进应用启动序列），其类型正确性直接影响
  // 运维可执行性，故纳入检查；根 `scripts/` 仍由 bun 运行时与定向测试覆盖，不在本 include 内。
  "include": ["apps/server/src/**/*.ts", "db/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
