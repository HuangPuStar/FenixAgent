      "@fenix-ce/agent-runtime": ["packages/agent/agent-runtime/src/index.ts"],
      "@fenix-ce/agent-runtime/module": ["packages/agent/agent-runtime/fenix.module.ts"],
      "@fenix-ce/agent-instance": ["packages/agent/agent-instance/src/index.ts"],
      "@fenix-ce/agent-config": ["packages/resources/agent-config/src/index.ts"],
